<?xml version="1.0"?>
<robot name="ms616">

  <!-- ============================================================
       MATERIALS
       ============================================================ -->
  <material name="chassis_grey">
    <color rgba="0.65 0.65 0.68 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="caster_grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="lidar_dark">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <!-- ============================================================
       BASE LINK  (chassis.stl) — origin at wheel-axle midpoint,
       matching the kinematic model's body frame {B}
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0.09 -0.09 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ms616/meshes/chassis.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ms616/meshes/chassis.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <!-- ============================================================
       LEFT DRIVE WHEEL — cylinder, radius 0.035, at +wheel_L on Y
       ============================================================ -->
  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.026"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00015"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.105 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============================================================
       RIGHT DRIVE WHEEL — cylinder, radius 0.035, at -wheel_L on Y
       ============================================================ -->
  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.026"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.026"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00015"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.105 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- ============================================================
       CASTER WHEEL  (caster.stl) — passive, behind drive axle
       ============================================================ -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ms616/meshes/caster.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0206"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-0.055 0 -0.0042" rpy="-1.5707 0 0"/>
  </joint>



    <link name="caster_link_back">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ms616/meshes/caster.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="caster_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0206"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="caster_joint_back" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link_back"/>
    <origin xyz="0.055 0 -0.0042" rpy="-1.5707 0 0"/>
  </joint>

  <!-- ============================================================
       2D LIDAR — mounted at same CAD location as original 3D
       lidar assembly. Visual mesh reused as the physical housing;
       sensor plugin below defines it as a single-plane scanner.
       ============================================================ -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707 0 0"/>
      <geometry>
        <mesh filename="package://ms616/meshes/Lidar_assy.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="lidar_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
  </joint>

  <!-- Clean sensor frame coincident with lidar_link — this is the
       frame_id that will appear in sensor_msgs/LaserScan -->
  <link name="lidar_scan_frame"/>

  <joint name="lidar_scan_joint" type="fixed">
    <parent link="lidar_link"/>
    <child link="lidar_scan_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       GAZEBO (Ignition Fortress) — 2D planar lidar sensor plugin

       type="gpu_lidar" — this Fortress build's SdfEntityCreator
       rejects plain type="lidar" for URDF-spawned models ("Sensor
       type LIDAR not supported yet. Try using a GPU LIDAR instead."),
       so gpu_lidar is required here regardless of render backend.
       The original concern (broken EGL/dri2 on this machine causing
       gpu_lidar to silently produce zero data) is addressed at the
       launch level instead: gazebo.launch.py runs the Gazebo SERVER
       with MESA_LOADER_DRIVER_OVERRIDE=llvmpipe + LIBGL_ALWAYS_SOFTWARE=1
       so its Sensors system render thread falls back to software
       rendering, while the GUI process runs separately with the
       working hardware GL path untouched.

       IMPORTANT (Fortress-specific): this sensor will NOT produce
       data unless the WORLD sdf loads the Sensors system plugin:
         <plugin filename="ignition-gazebo-sensors-system"
                 name="ignition::gazebo::systems::Sensors">
           <render_engine>ogre2</render_engine>
         </plugin>
       default_world.sdf (installed with this package) already
       includes this.
       ============================================================ -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_2d" type="gpu_lidar">
      <ignition_frame_id>lidar_scan_frame</ignition_frame_id>
      <pose relative_to="lidar_scan_frame">0 0 0 0 0 0</pose>
      <topic>/model/ms616/sensor/lidar_2d/scan</topic>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- ============================================================
       ros2_control — diff drive hardware interface
       (swap the <plugin> under <hardware> to your real motor
       driver when you port this to actual hardware)

       NOTE: your installed Gazebo Sim is 6.18.0 = Ignition Fortress.
       Fortress predates the gz_sim/GZ_* rename (that happened in
       Garden/Harmonic) — it uses the ign_ros2_control package and
       ign_ros2_control/IgnitionSystem hardware plugin, NOT
       gz_ros2_control/GazeboSimSystem.
       ============================================================ -->
  <ros2_control name="ms616_system" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- NOTE: ign_ros2_control does NOT resolve package:// URIs — it opens
       this string as a literal filesystem path. __MS616_CONFIG_PATH__ is
       substituted for the real absolute install path by gazebo.launch.py
       before this file is published as robot_description.

       Fortress plugin filename/class: libign_ros2_control-system.so /
       ign_ros2_control::IgnitionROS2ControlPlugin (NOT the Harmonic-era
       gz_ros2_control-system / GazeboSimROS2ControlPlugin). -->
  <gazebo>
    <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>__MS616_CONFIG_PATH__/diff_drive_controller.yaml</parameters>
    </plugin>
  </gazebo>





<link name="imu_link">
  <inertial>
    <!-- Negligible mass/inertia — real IMU boards are ~5-15g -->
    <mass value="0.01"/>
    <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
  </inertial>
  <visual>
    <geometry>
      <box size="0.02 0.02 0.01"/>
    </geometry>
  </visual>
  <collision>
    <geometry>
      <box size="0.02 0.02 0.01"/>
    </geometry>
  </collision>
</link>
 
<joint name="imu_joint" type="fixed">
  <parent link="base_link"/>
  <child link="imu_link"/>
  <!-- CHECK: adjust xyz to your desired IMU mounting position
       relative to base_link's origin -->
  <origin xyz="0 0 0.05" rpy="0 0 0"/>
</joint>
 
<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">

    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <ignition_frame_id>imu_link</ignition_frame_id>
    <topic>imu</topic>
    <!--
      NOISE: deliberately non-zero, matching the hardware-transfer
      goal in the request — a perfect zero-noise sim IMU produces
      an EKF covariance that's meaningless once you move to a real
      IMU. These stddev values are representative of a low-cost
      MEMS IMU (e.g. MPU6050-class); tune down for a higher-grade
      part (e.g. BMI088-class) once you know your real hardware.
    -->
    <imu>
      <angular_velocity>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>





</robot>